# Only ONE value is yours to fill in. Paste/import this file in Vercel:
#   Project → Settings → Environment Variables → "Import .env"

# MongoDB connection string (Atlas: Connect → Drivers → copy the string, put your password in)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# --- You do NOT need to set these ---
# BLOB_READ_WRITE_TOKEN  → added automatically when you create a Blob store (Storage tab) and connect it to the project
# MAX_FILE_MB=1024       → optional, can only lower the 1 GB cap
# CRON_SECRET=           → optional
