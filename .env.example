# =====================================================================
# Parcel / fileshare — environment reference.
# Copy to `.env` (docker compose reads it) and, for running the backend
# directly, to `backend/.env`. Never commit real values.
# =====================================================================

# --- Runtime -----------------------------------------------------------
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (so req.ip / rate limits use the real client IP).
TRUST_PROXY=1

# --- URLs / CORS ---------------------------------------------------------
# Origin(s) of the frontend, comma separated. Must match exactly (scheme + host + port).
PUBLIC_APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080

# --- MongoDB -----------------------------------------------------------
MONGODB_URI=mongodb://mongo:27017/fileshare
# Atlas / replica set example:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/fileshare?retryWrites=true&w=majority

# --- Auth ----------------------------------------------------------------
# REQUIRED in production: long random string (e.g. `openssl rand -base64 48`). Also keys the
# HMAC used to pseudonymise client IPs, so changing it resets per-client upload counters.
JWT_SECRET=change-me-to-a-long-random-string
SESSION_DAYS=7
# Defaults to true in production. Set false only for plain-http local testing.
COOKIE_SECURE=false
# lax works when the frontend proxies /api (same site). Use `none` (+ COOKIE_SECURE=true) only for a cross-site API.
COOKIE_SAMESITE=lax
# Bootstrap administrator, created on first start if missing.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Storage -------------------------------------------------------------
# local | s3
STORAGE_PROVIDER=s3
# local:
LOCAL_STORAGE_PATH=/data/storage
# s3 (AWS S3, MinIO, Cloudflare R2, Backblaze B2, Wasabi, ...):
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=fileshare
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_KEY_PREFIX=files/

# --- Upload policy (defaults; admins can lower them at runtime in the dashboard) ---
# Hard ceiling is 3 GB (3221225472) and cannot be exceeded.
MAX_FILE_BYTES=3221225472
# Size of each resumable chunk. S3 requires >= 5 MiB. Larger = fewer requests, smaller = cheaper retries.
PART_SIZE_BYTES=8388608
# Total bytes the service may hold (all non-deleted files, including in-progress uploads).
STORAGE_QUOTA_BYTES=536870912000
UPLOAD_SESSION_TTL_HOURS=24
UPLOAD_IDLE_TIMEOUT_MINUTES=120
COMPUTE_CHECKSUM=true
VERIFY_SIGNATURES=true
# Optional JSON file extending / overriding the file-type registry (see README).
# FILE_POLICY_PATH=/app/file-policy.json
ALLOW_ANONYMOUS_UPLOADS=true
ALLOW_REGISTRATION=true
UPLOADS_PER_HOUR=60

# --- Rate limits (per instance, per IP) ------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=600
RATE_LIMIT_PARTS_MAX=3000
RATE_LIMIT_DOWNLOAD_MAX=120
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PASSWORD_MAX=8

# --- Malware scanning ------------------------------------------------------
# none | clamav   (clamd must have StreamMaxLength >= 3G)
SCANNER=none
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Background cleanup worker -------------------------------------------------
# true: the API process runs the worker. false: run `node dist/worker.js` separately (recommended when scaling the API).
RUN_WORKER_IN_API=false
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=50
DELETE_MAX_ATTEMPTS=8
DELETE_RETRY_BASE_SECONDS=30
# Hours a "deleted" tombstone is kept (so links answer 410 instead of 404). 0 = delete record immediately.
TOMBSTONE_HOURS=24

# --- docker-compose only -------------------------------------------------------
WEB_PORT=8080
