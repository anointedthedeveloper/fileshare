{
  "name": "fileshare-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration",
    "test:integration": "vitest run tests/integration",
    "db:init": "tsx src/scripts/initDb.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "bcryptjs": "^3.0.3",
    "content-disposition": "^3.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "range-parser": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/content-disposition": "^0.5.9",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/range-parser": "^1.2.7",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
